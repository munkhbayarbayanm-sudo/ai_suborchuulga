# Development-only example; bind all services to loopback.
DATABASE_URL=postgresql://mongolsub:local_dev_only@127.0.0.1:56432/mongolsub
REDIS_URL=redis://127.0.0.1:56379
STORAGE_ROOT=./data/media
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
MAX_UPLOAD_BYTES=2147483648
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg
MEDIA_PROCESS_TIMEOUT_MS=60000
RENDER_PROCESS_TIMEOUT_MS=21600000
MAX_RENDER_OUTPUT_BYTES=10737418240
WORKER_CONCURRENCY=2
# Optional local inference service; empty token means unavailable, core still boots.
MEDIA_WORK_ROOT=./data/work
EXTRACTION_PROVIDER_URL=http://127.0.0.1:8765
EXTRACTION_PROVIDER_TOKEN=
EXTRACTION_TIMEOUT_MS=7200000
OCR_MAX_FRAMES=20000
# Optional cloud localization; configure a structured-output capable model server-side.
# Leave key/model empty to keep translation unavailable while other phases work.
LOCALIZATION_PROVIDER=openai
LOCALIZATION_API_KEY=
LOCALIZATION_MODEL=
LOCALIZATION_BASE_URL=https://api.openai.com/v1
LOCALIZATION_TIMEOUT_MS=120000
LOCALIZATION_MAX_OUTPUT_TOKENS=10000
LOCALIZATION_MAX_ATTEMPTS=3
LOCALIZATION_RETRY_BASE_MS=1000
