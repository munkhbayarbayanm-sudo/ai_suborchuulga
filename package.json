{
  "name": "mongolsub-studio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "dotenv -e .env -- node scripts/dev.mjs",
    "dev:local-infra": "dotenv -e .env -- node scripts/local-infra.mjs",
    "dev:providers": "dotenv -e .env -- node scripts/providers.mjs",
    "build": "dotenv -e .env -- turbo run build",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.tooling.json",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:integration": "dotenv -e .env -- vitest run --project integration",
    "test:smoke": "dotenv -e .env -- tsx scripts/smoke.ts",
    "db:generate": "pnpm --filter @mongolsub/database generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @mongolsub/database migrate",
    "fixture": "dotenv -e .env -- tsx scripts/create-fixture.ts",
    "fixture:sources": "dotenv -e .env -- tsx scripts/create-source-fixture.ts",
    "test:smoke:sources": "dotenv -e .env -- tsx scripts/source-smoke.ts",
    "test:smoke:fusion": "dotenv -e .env -- tsx scripts/fusion-runtime-smoke.ts",
    "test:smoke:localization": "dotenv -e .env -- tsx scripts/localization-provider-smoke.ts",
    "benchmark:fusion": "tsx scripts/fusion-benchmark.ts",
    "benchmark:fusion:persistence": "dotenv -e .env -- tsx scripts/fusion-persistence-benchmark.ts",
    "benchmark:localization": "dotenv -e .env -- tsx scripts/localization-benchmark.ts",
    "benchmark:editor": "dotenv -e .env -- tsx scripts/editor-benchmark.ts",
    "benchmark:qc": "dotenv -e .env -- tsx scripts/qc-benchmark.ts",
    "benchmark:video-editor": "tsx scripts/video-editor-benchmark.ts",
    "benchmark:render": "tsx scripts/render-benchmark.ts",
    "benchmark:render:runtime": "dotenv -e .env -- tsx scripts/render-runtime-benchmark.ts",
    "db:test:migrations": "dotenv -e .env -- tsx scripts/check-migrations.ts"
  },
  "devDependencies": {
    "@mongolsub/render": "workspace:*",
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "bullmq": "^5.63.0",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "turbo": "^2.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0",
    "zod": "^3.25.0"
  }
}
