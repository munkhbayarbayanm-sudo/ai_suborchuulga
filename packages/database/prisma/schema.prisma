generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum AssetStatus {
  IMPORTED
  INSPECTING
  READY
  FAILED
}
enum StreamType {
  VIDEO
  AUDIO
  SUBTITLE
  OTHER
}
enum JobType {
  INSPECT_MEDIA
  EXTRACT_EMBEDDED_SUBTITLE
  TRANSCRIBE_AUDIO
  OCR_BURNED_SUBTITLE
  FUSE_TRANSCRIPT
  LOCALIZE_TRANSCRIPT
  GENERATE_EDITOR_PROXY
  GENERATE_WAVEFORM
}

enum LocalizationMode {
  STRICT
  NATURAL
  CINEMATIC
}
enum LocalizationEditState {
  PENDING
  AI_GENERATED
  AI_REVISED
  MANUALLY_EDITED
}
enum GlossaryScope {
  GLOBAL
  SERIES
  EPISODE
  CHARACTER
}
enum MemoryStatus {
  ACTIVE
  ARCHIVED
}
enum TranslationMemoryOrigin {
  HUMAN_APPROVED
  IMPORTED
  AI_SUGGESTED
}
enum TranslationMemoryStatus {
  TRUSTED
  SUGGESTED
  ARCHIVED
}

enum FusionLanguage {
  AUTO
  ENGLISH
  CHINESE
}
enum ReviewCategory {
  HIGH_CONFIDENCE
  REVIEW_RECOMMENDED
  LIKELY_PROBLEM
}
enum ReviewStatus {
  UNREVIEWED
  REVIEWED
  APPROVED
}
enum DerivationType {
  DIRECT
  RECONCILED
  MANUAL
}
enum EvidenceRole {
  PRIMARY
  SUPPORTING
  TIMING_ONLY
  CONFLICTING
}
enum ExtractionMethod {
  EMBEDDED_SUBTITLE
  ASR
  OCR
}
enum DerivativeType {
  AUDIO_MONO_16K
  EDITOR_PROXY_MP4
  WAVEFORM_PEAKS
}
enum SubtitleDocumentStatus {
  READY
  ARCHIVED
}
enum SubtitleCueStatus {
  NORMAL
  REVIEW
  APPROVED
}
enum SubtitleCueOrigin {
  LOCALIZED
  MANUAL
}
enum EditorOperationType {
  UPDATE_TEXT
  MOVE_CUE
  RESIZE_START
  RESIZE_END
  SPLIT_CUE
  MERGE_CUES
  DELETE_CUE
  CREATE_CUE
  SET_CUE_STATUS
  ACCEPT_AI_REWRITE
  UNDO
  REDO
}
enum EditorRewriteAction {
  RETRANSLATE
  MAKE_NATURAL
  SHORTER
  MORE_FORMAL
  MORE_CASUAL
  CLOSER_TO_SOURCE
}
enum EditorProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  SUPERSEDED
}
enum EditorPreparationKind {
  EDITOR_PROXY
  WAVEFORM
}
enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}
model Series {
  id String @id @default(uuid()) @db.Uuid
  title String @db.VarChar(200)
  description String?
  sourceLanguage String? @db.VarChar(35)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  episodes Episode[]
  localizationProfile SeriesLocalizationProfile?
  characters Character[]
  relationships CharacterRelationship[]
  glossary GlossaryEntry[]
  translationMemory TranslationMemoryEntry[]
}
model Episode {
  id String @id @default(uuid()) @db.Uuid
  seriesId String @db.Uuid
  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  title String @db.VarChar(200)
  episodeNumber Int?
  sourceLanguage String? @db.VarChar(35)
  activeFusionRunId String? @db.Uuid
  activeFusionRun FusionRun? @relation("ActiveFusion", fields: [activeFusionRunId, id], references: [id, episodeId], onDelete: NoAction)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  mediaAssets MediaAsset[]
  jobs ProcessingJob[]
  extractions SourceExtractionRun[]
  fusionRuns FusionRun[] @relation("EpisodeFusions")
  activeLocalizationRunId String? @db.Uuid
  activeLocalizationRun LocalizationRun? @relation("ActiveLocalization", fields: [activeLocalizationRunId, id], references: [id, episodeId], onDelete: NoAction)
  localizationRuns LocalizationRun[] @relation("EpisodeLocalizations")
  activeSubtitleDocumentId String? @db.Uuid
  activeSubtitleDocument SubtitleDocument? @relation("ActiveSubtitleDocument", fields: [activeSubtitleDocumentId, id], references: [id, episodeId], onDelete: NoAction)
  subtitleDocuments SubtitleDocument[] @relation("EpisodeSubtitleDocuments")
  glossary GlossaryEntry[]
  @@unique([id, seriesId])
  @@index([seriesId])
}
model MediaAsset {
  id String @id @default(uuid()) @db.Uuid
  episodeId String @db.Uuid
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  originalFilename String @db.VarChar(255)
  storageKey String @unique
  mimeType String @db.VarChar(100)
  sizeBytes BigInt
  durationMs Int?
  containerFormat String?
  width Int?
  height Int?
  status AssetStatus @default(IMPORTED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  streams MediaStream[]
  jobs ProcessingJob[]
  extractions SourceExtractionRun[]
  derivatives MediaDerivative[]
  fusionRuns FusionRun[]
  subtitleDocuments SubtitleDocument[]
  editorPreparations EditorMediaPreparation[]
  @@unique([id, episodeId])
  @@index([episodeId])
}
model MediaStream {
  id String @id @default(uuid()) @db.Uuid
  mediaAssetId String @db.Uuid
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  streamIndex Int
  type StreamType
  codec String?
  language String?
  title String?
  width Int?
  height Int?
  frameRate Float?
  channels Int?
  sampleRate Int?
  extractions SourceExtractionRun[]
  @@unique([id, mediaAssetId])
  @@unique([mediaAssetId, streamIndex])
}
model ProcessingJob {
  id String @id @default(uuid()) @db.Uuid
  jobType JobType @default(INSPECT_MEDIA)
  status JobStatus @default(QUEUED)
  progress Int @default(0)
  episodeId String? @db.Uuid
  episode Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  mediaAssetId String? @db.Uuid
  mediaAsset MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  errorCode String?
  errorMessage String?
  createdAt DateTime @default(now())
  startedAt DateTime?
  completedAt DateTime?
  updatedAt DateTime @updatedAt
  extractionRun SourceExtractionRun?
  fusionRun FusionRun?
  localizationRun LocalizationRun?
  editorPreparation EditorMediaPreparation?
  @@index([status, createdAt])
  @@index([episodeId])
  @@index([mediaAssetId])
}
model SourceExtractionRun {
  id String @id @default(uuid()) @db.Uuid
  episodeId String @db.Uuid
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  mediaAssetId String @db.Uuid
  mediaAsset MediaAsset @relation(fields: [mediaAssetId, episodeId], references: [id, episodeId], onDelete: Cascade)
  streamId String? @db.Uuid
  stream MediaStream? @relation(fields: [streamId, mediaAssetId], references: [id, mediaAssetId], onDelete: Restrict)
  streamIndex Int?
  method ExtractionMethod
  provider String @db.VarChar(80)
  providerVersion String? @db.VarChar(120)
  modelVersion String? @db.VarChar(200)
  languageRequested String? @db.VarChar(35)
  languageDetected String? @db.VarChar(35)
  status JobStatus @default(QUEUED)
  settings Json
  settingsHash String @db.VarChar(64)
  revision String @default("default") @db.VarChar(36)
  identityHash String @unique @db.VarChar(64)
  processingJobId String @unique @db.Uuid
  processingJob ProcessingJob @relation(fields: [processingJobId], references: [id], onDelete: Cascade)
  stage String?
  device String? @db.VarChar(8)
  processingDurationMs Int?
  startedAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  segments SourceSegment[]
  fusionInputs FusionRunInput[]
  @@unique([id, mediaAssetId])
  @@index([episodeId, createdAt])
  @@index([mediaAssetId, method])
}
model SourceSegment {
  id String @id @default(uuid()) @db.Uuid
  extractionRunId String @db.Uuid
  extractionRun SourceExtractionRun @relation(fields: [extractionRunId], references: [id], onDelete: Cascade)
  startMs Int
  endMs Int
  text String
  language String? @db.VarChar(35)
  confidence Float?
  speaker String? @db.VarChar(100)
  sequence Int
  words Json @default("[]")
  providerMetadata Json
  createdAt DateTime @default(now())
  evidenceLinks TranscriptEvidenceLink[]
  @@unique([id, extractionRunId])
  @@unique([extractionRunId, sequence])
  @@index([extractionRunId, startMs, sequence])
}
model MediaDerivative {
  id String @id @default(uuid()) @db.Uuid
  mediaAssetId String @db.Uuid
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  type DerivativeType
  streamIndex Int
  storageKey String @unique
  settings Json
  settingsHash String @db.VarChar(64)
  sizeBytes BigInt
  createdAt DateTime @default(now())
  editorPreparation EditorMediaPreparation?
  @@unique([mediaAssetId, type, streamIndex, settingsHash])
}

model FusionRun {
  id String @id @default(uuid()) @db.Uuid
  episodeId String @db.Uuid
  episode Episode @relation("EpisodeFusions", fields: [episodeId], references: [id], onDelete: Cascade)
  selectedBy Episode[] @relation("ActiveFusion")
  mediaAssetId String @db.Uuid
  mediaAsset MediaAsset @relation(fields: [mediaAssetId, episodeId], references: [id, episodeId], onDelete: Cascade)
  requestedLanguage FusionLanguage
  canonicalLanguage String @db.VarChar(2)
  languageReason String
  status JobStatus @default(QUEUED)
  algorithmVersion String @db.VarChar(80)
  settings Json
  revision String @default("default") @db.VarChar(36)
  identityHash String @unique @db.VarChar(64)
  overallConfidence Float?
  coverageMetrics Json?
  processingJobId String @unique @db.Uuid
  processingJob ProcessingJob @relation(fields: [processingJobId], references: [id], onDelete: Cascade)
  stage String?
  alignmentDurationMs Int?
  reconciliationDurationMs Int?
  persistenceDurationMs Int?
  processingDurationMs Int?
  startedAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  inputs FusionRunInput[]
  segments TranscriptSegment[]
  localizationRuns LocalizationRun[]
  @@unique([id, episodeId])
  @@unique([id, mediaAssetId])
  @@index([episodeId, createdAt])
}
model FusionRunInput {
  fusionRunId String @db.Uuid
  sourceExtractionRunId String @db.Uuid
  mediaAssetId String @db.Uuid
  fusionRun FusionRun @relation(fields: [fusionRunId, mediaAssetId], references: [id, mediaAssetId], onDelete: Cascade)
  sourceExtractionRun SourceExtractionRun @relation(fields: [sourceExtractionRunId, mediaAssetId], references: [id, mediaAssetId], onDelete: NoAction)
  evidenceLinks TranscriptEvidenceLink[]
  @@id([fusionRunId, sourceExtractionRunId])
  @@index([sourceExtractionRunId])
}
model TranscriptSegment {
  id String @id @default(uuid()) @db.Uuid
  fusionRunId String @db.Uuid
  fusionRun FusionRun @relation(fields: [fusionRunId], references: [id], onDelete: Cascade)
  sequence Int
  startMs Int
  endMs Int
  text String
  derivedStartMs Int
  derivedEndMs Int
  derivedText String
  language String @db.VarChar(2)
  speaker String? @db.VarChar(100)
  confidence Float
  reviewCategory ReviewCategory
  reviewStatus ReviewStatus @default(UNREVIEWED)
  derivationType DerivationType
  contentType String @default("UNKNOWN") @db.VarChar(20)
  confidenceReasons Json
  manualEditedAt DateTime?
  editRevision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  evidence TranscriptEvidenceLink[]
  localizations LocalizedSegment[]
  @@unique([id, fusionRunId])
  @@unique([fusionRunId, sequence])
  @@index([fusionRunId, startMs, sequence])
  @@index([fusionRunId, reviewCategory, startMs])
  @@index([fusionRunId, manualEditedAt])
}
model TranscriptEvidenceLink {
  transcriptSegmentId String @db.Uuid
  fusionRunId String @db.Uuid
  sourceSegmentId String @db.Uuid
  sourceExtractionRunId String @db.Uuid
  transcriptSegment TranscriptSegment @relation(fields: [transcriptSegmentId, fusionRunId], references: [id, fusionRunId], onDelete: Cascade)
  sourceSegment SourceSegment @relation(fields: [sourceSegmentId, sourceExtractionRunId], references: [id, extractionRunId], onDelete: NoAction)
  input FusionRunInput @relation(fields: [fusionRunId, sourceExtractionRunId], references: [fusionRunId, sourceExtractionRunId], onDelete: NoAction)
  role EvidenceRole
  alignmentScore Float
  textSimilarity Float?
  temporalOverlap Float
  contributionWeight Float?
  @@id([transcriptSegmentId, sourceSegmentId])
  @@index([sourceSegmentId])
}

model SeriesLocalizationProfile {
  seriesId String @id @db.Uuid
  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  defaultMode LocalizationMode @default(NATURAL)
  generalTone String @default("")
  setting String @default("")
  preferredStyle String @default("")
  formalityGuidance String @default("")
  nameHandling String @default("")
  specialNotes String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Character {
  id String @id @default(uuid()) @db.Uuid
  seriesId String @db.Uuid
  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  canonicalName String @db.VarChar(200)
  sourceName String @db.VarChar(500)
  mongolianName String? @db.VarChar(500)
  role String? @db.VarChar(500)
  title String? @db.VarChar(500)
  speakingStyle String?
  formality String? @db.VarChar(500)
  notes String?
  aliases CharacterAlias[]
  relationshipsFrom CharacterRelationship[] @relation("RelationshipFrom")
  relationshipsTo CharacterRelationship[] @relation("RelationshipTo")
  glossary GlossaryEntry[]
  translationMemory TranslationMemoryEntry[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([id, seriesId])
  @@index([seriesId, canonicalName])
}
model CharacterAlias {
  id String @id @default(uuid()) @db.Uuid
  characterId String @db.Uuid
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  alias String @db.VarChar(200)
  @@unique([characterId, alias])
}
model CharacterRelationship {
  id String @id @default(uuid()) @db.Uuid
  seriesId String @db.Uuid
  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  fromCharacterId String @db.Uuid
  toCharacterId String @db.Uuid
  fromCharacter Character @relation("RelationshipFrom", fields: [fromCharacterId, seriesId], references: [id, seriesId], onDelete: Cascade)
  toCharacter Character @relation("RelationshipTo", fields: [toCharacterId, seriesId], references: [id, seriesId], onDelete: Cascade)
  type String @db.VarChar(200)
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([seriesId, fromCharacterId, toCharacterId, type])
}
model GlossaryEntry {
  id String @id @default(uuid()) @db.Uuid
  scope GlossaryScope
  seriesId String? @db.Uuid
  series Series? @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  episodeId String? @db.Uuid
  episode Episode? @relation(fields: [episodeId, seriesId], references: [id, seriesId], onDelete: Cascade)
  characterId String? @db.Uuid
  character Character? @relation(fields: [characterId, seriesId], references: [id, seriesId], onDelete: Cascade)
  sourceLanguage String @db.VarChar(2)
  sourceTerm String @db.VarChar(500)
  preferredMongolian String @db.VarChar(1000)
  notes String?
  caseSensitive Boolean @default(false)
  status MemoryStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([seriesId, sourceLanguage, sourceTerm])
  @@index([scope, status])
}
model TranslationMemoryEntry {
  id String @id @default(uuid()) @db.Uuid
  seriesId String @db.Uuid
  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  sourceLanguage String @db.VarChar(2)
  sourceText String
  normalizedSourceText String
  normalizedSourceHash String @db.VarChar(64)
  mongolianText String
  characterId String? @db.Uuid
  character Character? @relation(fields: [characterId, seriesId], references: [id, seriesId], onDelete: NoAction)
  origin TranslationMemoryOrigin
  status TranslationMemoryStatus
  identityHash String @unique @db.VarChar(64)
  sourceLocalizedSegmentId String? @db.Uuid
  sourceLocalizedSegment LocalizedSegment? @relation(fields: [sourceLocalizedSegmentId], references: [id], onDelete: NoAction)
  sourceRevision Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([seriesId, sourceLanguage])
  @@index([seriesId, sourceLanguage, normalizedSourceHash])
  @@index([sourceLocalizedSegmentId])
}
model LocalizationRun {
  id String @id @default(uuid()) @db.Uuid
  episodeId String @db.Uuid
  episode Episode @relation("EpisodeLocalizations", fields: [episodeId], references: [id], onDelete: Cascade)
  selectedBy Episode[] @relation("ActiveLocalization")
  fusionRunId String @db.Uuid
  fusionRun FusionRun @relation(fields: [fusionRunId, episodeId], references: [id, episodeId], onDelete: NoAction)
  sourceLanguage String @db.VarChar(2)
  targetLanguage String @default("mn") @db.VarChar(2)
  mode LocalizationMode
  provider String @db.VarChar(80)
  model String @db.VarChar(120)
  providerVersion String? @db.VarChar(120)
  promptVersion String @db.VarChar(80)
  pipelineVersion String @db.VarChar(80)
  settings Json
  contextSnapshot Json
  sourceSnapshotHash String @db.VarChar(64)
  identityHash String @unique @db.VarChar(64)
  revision String @default("default") @db.VarChar(36)
  status JobStatus @default(QUEUED)
  stage String?
  processingJobId String @unique @db.Uuid
  processingJob ProcessingJob @relation(fields: [processingJobId], references: [id], onDelete: Cascade)
  segmentCount Int
  completedSegmentCount Int @default(0)
  highConfidenceCount Int @default(0)
  reviewRecommendedCount Int @default(0)
  likelyProblemCount Int @default(0)
  batchCount Int
  completedBatchCount Int @default(0)
  inputTokens Int?
  outputTokens Int?
  cachedTokens Int?
  usageComplete Boolean @default(false)
  estimatedCost Float?
  processingDurationMs Int?
  createdAt DateTime @default(now())
  startedAt DateTime?
  completedAt DateTime?
  updatedAt DateTime @updatedAt
  batches LocalizationBatch[]
  segments LocalizedSegment[]
  subtitleDocuments SubtitleDocument[]
  @@unique([id, episodeId])
  @@unique([id, fusionRunId])
  @@index([episodeId, createdAt])
}
model LocalizationBatch {
  id String @id @default(uuid()) @db.Uuid
  localizationRunId String @db.Uuid
  localizationRun LocalizationRun @relation(fields: [localizationRunId], references: [id], onDelete: Cascade)
  batchIndex Int
  status JobStatus @default(QUEUED)
  targetSegmentIds Json
  draftResults Json?
  draftUsage Json?
  reviewUsage Json?
  errorCode String?
  processingDurationMs Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([localizationRunId, batchIndex])
}
model LocalizedSegment {
  id String @id @default(uuid()) @db.Uuid
  localizationRunId String @db.Uuid
  fusionRunId String @db.Uuid
  localizationRun LocalizationRun @relation(fields: [localizationRunId, fusionRunId], references: [id, fusionRunId], onDelete: Cascade)
  transcriptSegmentId String @db.Uuid
  transcriptSegment TranscriptSegment @relation(fields: [transcriptSegmentId, fusionRunId], references: [id, fusionRunId], onDelete: NoAction)
  sequence Int
  sourceTextSnapshot String
  sourceStartMs Int
  sourceEndMs Int
  sourceConfidence Float
  sourceReviewCategory ReviewCategory
  sourceReviewStatus ReviewStatus
  sourceEditRevision Int
  sourceSpeaker String? @db.VarChar(100)
  machineDraft String?
  currentText String?
  providerConfidence Float?
  confidence Float?
  confidenceReasons Json @default("[]")
  reviewClassification ReviewCategory?
  editState LocalizationEditState @default(PENDING)
  humanReviewState ReviewStatus @default(UNREVIEWED)
  revision Int @default(0)
  characterCount Int?
  readingLoad Float?
  alternativeTranslation String?
  suggestedLineBreak String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  translationMemory TranslationMemoryEntry[]
  subtitleCueLinks SubtitleCueSourceLink[]
  @@unique([id, localizationRunId])
  @@unique([localizationRunId, transcriptSegmentId])
  @@unique([localizationRunId, sequence])
  @@index([localizationRunId, reviewClassification, sequence])
  @@index([localizationRunId, humanReviewState, sequence])
  @@index([localizationRunId, editState, sequence])
  @@index([transcriptSegmentId])
}

model SubtitleDocument {
  id String @id @default(uuid()) @db.Uuid
  episodeId String @db.Uuid
  episode Episode @relation("EpisodeSubtitleDocuments", fields: [episodeId], references: [id], onDelete: Cascade)
  selectedBy Episode[] @relation("ActiveSubtitleDocument")
  mediaAssetId String @db.Uuid
  mediaAsset MediaAsset @relation(fields: [mediaAssetId, episodeId], references: [id, episodeId], onDelete: NoAction)
  localizationRunId String @db.Uuid
  localizationRun LocalizationRun @relation(fields: [localizationRunId, episodeId], references: [id, episodeId], onDelete: NoAction)
  language String @default("mn") @db.VarChar(2)
  name String @db.VarChar(200)
  status SubtitleDocumentStatus @default(READY)
  editorVersion String @db.VarChar(80)
  revision Int @default(0)
  initializationKey String @db.VarChar(36)
  identityHash String @unique @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cues SubtitleCue[]
  operations EditorOperation[] @relation("DocumentOperations")
  proposals EditorRewriteProposal[]
  @@unique([id, episodeId])
  @@unique([id, localizationRunId])
  @@unique([localizationRunId, initializationKey])
  @@index([episodeId, createdAt])
}

model SubtitleCue {
  id String @id @default(uuid()) @db.Uuid
  subtitleDocumentId String @db.Uuid
  localizationRunId String @db.Uuid
  document SubtitleDocument @relation(fields: [subtitleDocumentId, localizationRunId], references: [id, localizationRunId], onDelete: Cascade)
  sequence Int
  startMs Int
  endMs Int
  text String
  status SubtitleCueStatus @default(NORMAL)
  origin SubtitleCueOrigin @default(LOCALIZED)
  revision Int @default(0)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sourceLinks SubtitleCueSourceLink[]
  proposals EditorRewriteProposal[]
  @@index([subtitleDocumentId, deletedAt, sequence])
  @@index([subtitleDocumentId, startMs, endMs])
}

model SubtitleCueSourceLink {
  subtitleCueId String @db.Uuid
  localizedSegmentId String @db.Uuid
  localizationRunId String @db.Uuid
  cue SubtitleCue @relation(fields: [subtitleCueId], references: [id], onDelete: Cascade)
  localizedSegment LocalizedSegment @relation(fields: [localizedSegmentId, localizationRunId], references: [id, localizationRunId], onDelete: NoAction)
  createdAt DateTime @default(now())
  @@id([subtitleCueId, localizedSegmentId])
  @@index([localizedSegmentId])
}

model EditorOperation {
  id String @id @default(uuid()) @db.Uuid
  subtitleDocumentId String @db.Uuid
  document SubtitleDocument @relation("DocumentOperations", fields: [subtitleDocumentId], references: [id], onDelete: Cascade)
  type EditorOperationType
  baseRevision Int
  resultRevision Int
  beforePayload Json
  afterPayload Json
  targetOperationId String? @db.Uuid
  targetOperation EditorOperation? @relation("OperationTarget", fields: [targetOperationId], references: [id], onDelete: NoAction)
  inverseOperations EditorOperation[] @relation("OperationTarget")
  clientOperationId String? @db.Uuid
  groupId String? @db.Uuid
  createdAt DateTime @default(now())
  acceptedProposal EditorRewriteProposal? @relation("AcceptedProposal")
  @@unique([subtitleDocumentId, resultRevision])
  @@unique([subtitleDocumentId, clientOperationId])
  @@index([subtitleDocumentId, createdAt])
  @@index([targetOperationId])
}

model EditorRewriteProposal {
  id String @id @default(uuid()) @db.Uuid
  subtitleDocumentId String @db.Uuid
  subtitleCueId String @db.Uuid
  document SubtitleDocument @relation(fields: [subtitleDocumentId], references: [id], onDelete: Cascade)
  cue SubtitleCue @relation(fields: [subtitleCueId], references: [id], onDelete: Cascade)
  action EditorRewriteAction
  status EditorProposalStatus @default(PENDING)
  baseDocumentRevision Int
  currentTextSnapshot String
  proposalText String
  provider String @db.VarChar(80)
  model String @db.VarChar(120)
  providerVersion String? @db.VarChar(120)
  confidence Float?
  notes Json @default("[]")
  usage Json?
  acceptedOperationId String? @unique @db.Uuid
  acceptedOperation EditorOperation? @relation("AcceptedProposal", fields: [acceptedOperationId], references: [id], onDelete: NoAction)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([subtitleCueId, createdAt])
  @@index([subtitleDocumentId, status])
}

model EditorMediaPreparation {
  id String @id @default(uuid()) @db.Uuid
  mediaAssetId String @db.Uuid
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  kind EditorPreparationKind
  settings Json
  settingsHash String @db.VarChar(64)
  status JobStatus @default(QUEUED)
  stage String?
  processingJobId String @unique @db.Uuid
  processingJob ProcessingJob @relation(fields: [processingJobId], references: [id], onDelete: Cascade)
  derivativeId String? @unique @db.Uuid
  derivative MediaDerivative? @relation(fields: [derivativeId], references: [id], onDelete: NoAction)
  startedAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([mediaAssetId, kind, settingsHash])
  @@index([status, createdAt])
}
